diff -ru a/vllm/v1/spec_decode/llm_base_proposer.py b/vllm/v1/spec_decode/llm_base_proposer.py
--- a/vllm/v1/spec_decode/llm_base_proposer.py	2026-10-01 06:10:18.552572322 -0400
+++ b/vllm/v1/spec_decode/llm_base_proposer.py	2026-10-01 06:11:04.976235323 -0400
@@ -532,6 +532,29 @@
         self.num_speculative_tokens = num_speculative_tokens
         self._last_draft_probs = None
         batch_size = common_attn_metadata.batch_size()
+        # Follow seq_lens on the host across the draft passes, so attention
+        # builders need no seq_lens.cpu() sync per pass: copy the rejected
+        # counts now, ahead of the first draft pass in the stream, and wait
+        # for that copy alone before the second pass.
+        rejected_ready = None
+        if (
+            num_speculative_tokens > 1
+            and num_rejected_tokens_gpu is not None
+            and common_attn_metadata.seq_lens_cpu_exact
+            and common_attn_metadata.seq_lens_cpu_upper_bound is not None
+            and num_rejected_tokens_gpu.shape[0]
+            <= common_attn_metadata.seq_lens_cpu_upper_bound.shape[0]
+        ):
+            n = num_rejected_tokens_gpu.shape[0]
+            buf = getattr(self, "_rejected_cpu", None)
+            if buf is None or buf.shape[0] < n or buf.dtype != num_rejected_tokens_gpu.dtype:
+                buf = torch.empty(
+                    max(n, 64), dtype=num_rejected_tokens_gpu.dtype, pin_memory=True
+                )
+                self._rejected_cpu = buf
+            buf[:n].copy_(num_rejected_tokens_gpu, non_blocking=True)
+            rejected_ready = torch.cuda.Event()
+            rejected_ready.record()
 
         if self.method in ("eagle3", "dflash"):
             model = self.model
@@ -683,6 +706,19 @@
         # (i.e., not the first proposal).
         if self.num_speculative_tokens > 1 and num_rejected_tokens_gpu is not None:
             common_attn_metadata.seq_lens -= num_rejected_tokens_gpu
+            exact = False
+            if rejected_ready is not None and common_attn_metadata.seq_lens_cpu_exact:
+                rejected_ready.synchronize()
+                n = num_rejected_tokens_gpu.shape[0]
+                lens = common_attn_metadata.seq_lens_cpu_upper_bound.clone()
+                lens[:n] -= self._rejected_cpu[:n].to(lens.dtype)
+                # The passes add 1 per position on the GPU unless a position
+                # reaches max_model_len (eagle_step_update_slot_mapping_and_
+                # metadata); stay exact only where that cannot happen.
+                if int(lens.max()) + self.num_speculative_tokens < self.max_model_len:
+                    common_attn_metadata.seq_lens_cpu_upper_bound = lens
+                    exact = True
+            common_attn_metadata.seq_lens_cpu_exact = exact
 
         block_size = self.block_size
         assert block_size > 0, "block_size has not been initialized."
